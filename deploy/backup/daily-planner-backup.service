[Unit]
Description=Back up the daily-planner database (pg_dump + restic to Cloudflare R2)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/apps/daily-planner/deploy/backup/backup.sh
# restic keeps its index cache here (systemd creates /var/cache/restic; the unit has no $HOME).
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
Nice=10
IOSchedulingClass=idle
