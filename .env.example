DATABASE_URL=sqlite:///data/planner.db

# Signs the login session cookie. Long and random; never commit the real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# true in production (HTTPS): the session cookie is then never sent over plain HTTP
SESSION_HTTPS_ONLY=false

# Docker Compose / PostgreSQL (docker compose up). Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
# To run the app from your Mac against the Compose database instead of SQLite:
# DATABASE_URL=postgresql+psycopg://planner:<POSTGRES_PASSWORD>@127.0.0.1:5433/planner
